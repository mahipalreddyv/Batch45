{
	"name": "covid_data_flow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "covid_data",
						"type": "DatasetReference"
					},
					"name": "BlobCovidCSV"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "WriteBlobSilver"
				}
			],
			"transformations": [
				{
					"name": "selectColumns"
				},
				{
					"name": "filterReCoveredCondition"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Date as string,",
				"          Country as string,",
				"          Confirmed as string,",
				"          Recovered as string,",
				"          Deaths as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     limit: 1,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> BlobCovidCSV",
				"BlobCovidCSV select(mapColumn(",
				"          Date,",
				"          Country,",
				"          Confirmed,",
				"          Recovered",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumns",
				"selectColumns filter(Recovered!='0') ~> filterReCoveredCondition",
				"filterReCoveredCondition sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {PAR1\u0015\u0002\u0019\\H\fspark_schema\u0015\b\u0000\u0015\f%\u0002\u0018\u0004Date%\u0000L\u001c\u0000\u0000\u0000\u0015\f%\u0002\u0018\u0007Country%\u0000L\u001c\u0000\u0000\u0000\u0015\f%\u0002\u0018     Confirmed%\u0000L\u001c\u0000\u0000\u0000\u0015\f%\u0002\u0018     Recovered%\u0000L\u001c\u0000\u0000\u0000\u0016\u0000\u0019\f\u0019} as string,",
				"          {\u0018\u0018org.apache.spark.version\u0018\u00053.4.3\u0000\u0018)org.apache.spark.sql.parquet.row.metadata\u0018�\u0002{\"type\":\"struct\"} as string,",
				"          {\"fields\":[{\"name\":\"Date\"} as string,",
				"          {\"type\":\"string\"3} as string,",
				"          {\"nullable\":true4} as string,",
				"          {\"metadata\":{}}5} as string,",
				"          {{\"name\":\"Country\"} as string,",
				"          {\"type\":\"string\"7} as string,",
				"          {\"nullable\":true8} as string,",
				"          {\"metadata\":{}}9} as string,",
				"          {{\"name\":\"Confirmed\"} as string,",
				"          {\"type\":\"string\"11} as string,",
				"          {\"nullable\":true12} as string,",
				"          {\"metadata\":{}}13} as string,",
				"          {{\"name\":\"Recovered\"} as string,",
				"          {\"type\":\"string\"15} as string,",
				"          {\"nullable\":true16} as string,",
				"          {\"metadata\":{}}]}\u0000\u0018Jparquet-mr version 1.12.3 (build f8dced182c4c1fbdec6ccb3185537b5a01e6ed6b)\u0019L\u001c\u0000\u0000\u001c\u0000\u0000\u001c\u0000\u0000\u001c\u0000\u0000\u00009\u0002\u0000\u0000PAR1} as string",
				"     ),",
				"     filePattern:(concat('covid', toString(currentDate(), 'yyyyMMdd'))),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> WriteBlobSilver"
			]
		}
	}
}