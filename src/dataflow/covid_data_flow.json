{
	"name": "covid_data_flow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "covid_data",
						"type": "DatasetReference"
					},
					"name": "BlobCovidCSV"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "covid_data",
						"type": "DatasetReference"
					},
					"name": "WriteBlobSilver"
				}
			],
			"transformations": [
				{
					"name": "selectColumns"
				},
				{
					"name": "filterReCoveredCondition"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Date as string,",
				"          Country as string,",
				"          Confirmed as string,",
				"          Recovered as string,",
				"          Deaths as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     limit: 1,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> BlobCovidCSV",
				"BlobCovidCSV select(mapColumn(",
				"          Date,",
				"          Country,",
				"          Confirmed,",
				"          Recovered",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumns",
				"selectColumns filter(Recovered!='0') ~> filterReCoveredCondition",
				"filterReCoveredCondition sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Date as string,",
				"          Country as string,",
				"          Confirmed as string,",
				"          Recovered as string,",
				"          Deaths as string",
				"     ),",
				"     filePattern:(concat('covid', toString(currentDate(), 'yyyyMMdd'))),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> WriteBlobSilver"
			]
		}
	}
}