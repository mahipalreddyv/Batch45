		{
			"name": "[concat(parameters('factoryName'), '/covid_data_flow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "covid_data",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "target",
								"type": "DatasetReference"
							},
							"name": "sinkcoviddata"
						}
					],
					"transformations": [
						{
							"name": "filterRecovered"
						},
						{
							"name": "selectwithoutdeaths"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Date as string,",
						"          Country as string,",
						"          Confirmed as string,",
						"          Recovered as string,",
						"          Deaths as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 filter(Recovered!='0') ~> filterRecovered",
						"filterRecovered select(mapColumn(",
						"          Date,",
						"          Country,",
						"          Confirmed,",
						"          Recovered",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectwithoutdeaths",
						"selectwithoutdeaths sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkcoviddata"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/covid_data')]",
				"[concat(variables('factoryId'), '/datasets/target')]"
			]
		},
